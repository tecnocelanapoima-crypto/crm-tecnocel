# ─────────────────────────────────────────────────────────────────────────────
# Tecnocel CRM — Variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Clave secreta para las sesiones Flask. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_un_valor_seguro

# URL pública de la app (se usa en el cuerpo del email de notificación)
APP_URL=https://tu-app.up.railway.app

# ── Webhook de entrada (Capa 1) ───────────────────────────────────────────────
# Token secreto que n8n debe enviar en el header X-Webhook-Token.
# Genera uno con: python -c "import secrets; print(secrets.token_hex(24))"
# Si no se configura, el endpoint queda DESPROTEGIDO (solo para desarrollo local).
WEBHOOK_TOKEN=cambia_esto_por_un_token_seguro

# ── SMTP — Notificaciones por correo al dueño ─────────────────────────────────
# Para Gmail: activa "Contraseñas de aplicación" en tu cuenta Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion
# Dirección que aparece como remitente (puede ser igual a SMTP_USER)
SMTP_FROM=CRM Tecnocel <tu_correo@gmail.com>

# ── n8n — Webhook de salida (bienvenida al cliente) ───────────────────────────
# URL del webhook en tu instancia de n8n que recibe el lead
# y envía el WhatsApp de bienvenida al cliente.
# Déjalo vacío para deshabilitar el disparo (el endpoint sigue funcionando).
N8N_WEBHOOK_URL_LEAD_BIENVENIDA=https://tu-n8n.app/webhook/lead-bienvenida

# ── Solo para tests locales (NO usar en producción) ───────────────────────────
# Sobreescribe la ruta de la base de datos SQLite.
# Útil para correr los tests sin tocar tecnocel.db.
# TECNOCEL_DB_PATH=/tmp/test_crm.db
